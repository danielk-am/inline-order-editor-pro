<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/phpunit/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" cacheResult="false">
  <php><ini name="memory_limit" value="512M"/></php>
  <testsuites><testsuite name="WooCommerce integration"><directory suffix="Test.php">tests/phpunit</directory></testsuite></testsuites>
  <coverage processUncoveredFiles="false"><include><directory suffix=".php">includes</directory><directory suffix=".php">modules/invoicing/includes</directory></include></coverage>
</phpunit>
